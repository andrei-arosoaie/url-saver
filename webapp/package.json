{
  "name": "know-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../server/openapi/openapi.yaml -o src/generated/api.d.ts",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "node scripts/verify-categories-browser.mjs",
    "test:browser:identification": "node scripts/verify-identification-browser.mjs",
    "test:browser:connections": "node scripts/verify-connections-browser.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
