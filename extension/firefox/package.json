{
  "name": "know-firefox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "package:dev": "node scripts/package-development.mjs",
    "generate": "openapi-typescript ../../server/openapi/openapi.yaml -o src/generated/api.d.ts",
    "postinstall": "wxt prepare",
    "build": "npm run generate && wxt build -b firefox --mv3",
    "zip": "npm run generate && wxt zip -b firefox --mv3",
    "dev": "wxt -b firefox --mv3",
    "typecheck": "npm run generate && wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "validate": "addons-linter .output/firefox-mv3 --self-hosted"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "addons-linter": "10.14.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
